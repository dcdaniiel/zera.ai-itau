# copie para zera_agent/.env — lido automaticamente pelo adk web, pelo uvicorn (api.main), pelo pytest e pelos scripts (zera_agent/__init__.py);
# variáveis já exportadas no shell têm precedência (como no Cloud Run, onde a config vem do serviço)
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=batalha-time-03-vhxk
# gemini-3.x é servido pelo endpoint global (404 em us-central1). Se o shell já exporta GOOGLE_CLOUD_LOCATION, rode `unset GOOGLE_CLOUD_LOCATION`.
GOOGLE_CLOUD_LOCATION=global
# fallback estável: gemini-2.5-flash
ZERA_MODEL=gemini-3.8-flash
ZERA_TEMPERATURA=0.2
# data simulada inicial da demo
ZERA_HOJE=2026-09-26

# --- dados (nunca mock) ---
# bigquery -> zera.perfil_cliente + zera.dividas_derivadas + zera.perfis_demo (k-means)  [rode antes: python -m dados.publicar_bq]
# amostra  -> dados/amostra_bq_extrato_sintetico.csv (export real da base do evento) + segmentação por regras (roda sem credenciais)
ZERA_FONTE=amostra
ZERA_BQ_DATASET=hackathon_dados
ZERA_BQ_TABELA=extrato_sintetico
ZERA_BQ_DATASET_ZERA=zera

# --- estado do cliente (acordo, consentimentos, gatilhos, memória) ---
# json (arquivo local .zera_state/) | bigquery (zera.estado_cliente, append-only) — Firestore não está liberado no projeto
ZERA_ESTADO=json

# --- agente ---
# 1 = root + especialistas (diagnóstico / negociador / acompanhamento)
ZERA_MULTIAGENTE=0
# guardrail de saída substitui valores fora das tools
ZERA_STRICT_NUMEROS=1
# 1 = Model Armor (template ZERA_MODEL_ARMOR_TEMPLATE) na entrada e na saída — infra/setup_gcp.sh cria o template
ZERA_MODEL_ARMOR=0
ZERA_MODEL_ARMOR_TEMPLATE=zera-guardrails

# --- observabilidade / FinOps ---
# 1 = traces + métricas OTel para telemetry.googleapis.com (Cloud Trace / Monitoring); precisa de credencial (ADC ou service account)
ZERA_OTEL_GCP=0
# 1 = métricas e custo por chamada também em BigQuery (zera.telemetria)
ZERA_TELEMETRIA_BQ=0
# logs JSON (1) ou texto (0); nível
ZERA_LOG_JSON=0
ZERA_LOG_LEVEL=INFO
# preços de referência (USD por 1M tokens) para o custo estimado por chamada/jornada — confirme na tabela do modelo
ZERA_PRECO_ENTRADA_USD_1M=0.30
ZERA_PRECO_SAIDA_USD_1M=2.50
