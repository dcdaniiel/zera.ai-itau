# copie para zera_agent/.env (o adk web lê este arquivo)
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=batalha-time-03-vhxk
GOOGLE_CLOUD_LOCATION=us-central1
ZERA_MODEL=gemini-2.5-flash
ZERA_TEMPERATURA=0.2
ZERA_FONTE=csv            # csv | bigquery
ZERA_FIRESTORE=0          # 1 = estado no Firestore (P1)
ZERA_MULTIAGENTE=0        # 1 = root + especialistas (P1)
ZERA_STRICT_NUMEROS=0     # 1 = substitui valores fora das tools na resposta
ZERA_HOJE=2026-09-26      # data simulada inicial
